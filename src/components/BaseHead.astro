---
import { Font } from 'astro:assets'

import { prod } from 'astro-pure/server'
import type { PageMeta } from '@/types'
import { publicURL } from '@/utils'
import config from 'virtual:config'

type Props = PageMeta

const { articleDate, modifiedDate, tags, description, ogImage, title } = Astro.props

const siteTitle = `${title} ${config.titleDelimiter} ${config.title}`
const canonicalURL = publicURL(Astro.url, Astro.site)
const canonicalPath = canonicalURL.pathname
const socialImageURL = new URL(ogImage ? ogImage : config.socialCard, Astro.url).href

// Structured data: who writes here, and what each post is.
const homeURL = new URL('/', Astro.site).href
const person = {
  '@type': 'Person',
  '@id': `${homeURL}#person`,
  name: config.author,
  url: homeURL,
  jobTitle: 'Engineering Manager',
  worksFor: { '@type': 'Organization', name: 'Batch', url: 'https://batch.com' },
  homeLocation: { '@type': 'Place', name: 'Lyon, France' },
  knowsAbout: [
    'Engineering management',
    'AI-assisted software development',
    'Code review',
    'Software delivery'
  ],
  // Profiles only: drop mailto: and on-site links such as /rss.xml.
  sameAs: (config.footer.social ?? []).map(({ href }) => href).filter((href) => /^https?:\/\//.test(href))
}
const graph: Record<string, unknown>[] = [person]
if (canonicalPath === '/') {
  graph.push({
    '@type': 'WebSite',
    '@id': `${homeURL}#website`,
    url: homeURL,
    name: config.title,
    description,
    inLanguage: config.locale.lang,
    publisher: { '@id': person['@id'] }
  })
}
if (articleDate) {
  graph.push({
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: canonicalURL.href,
    mainEntityOfPage: canonicalURL.href,
    image: socialImageURL,
    datePublished: articleDate,
    dateModified: modifiedDate ?? articleDate,
    author: { '@id': person['@id'] },
    publisher: { '@id': person['@id'] },
    inLanguage: config.locale.lang,
    ...(tags?.length && { keywords: tags.join(', ') })
  })
}
// `<` escaped so a title can never close the script tag.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(
  /</g,
  '\\u003c'
)
---

<meta charset='utf-8' />
<meta
  content='width=device-width, initial-scale=1.0, shrink-to-fit=no, viewport-fit=cover'
  name='viewport'
/>
<meta content='IE=edge' http-equiv='X-UA-Compatible' />
<title>{siteTitle}</title>

{/* Icons / Favicon */}
<link rel='icon' type={config.favicon.type} href={config.favicon.href} />
<link rel='shortcut icon' type={config.favicon.type} href={config.favicon.href} />
<link rel='icon' type='image/png' sizes='32x32' href='/favicon/favicon-32x32.png' />
<link rel='icon' type='image/png' sizes='16x16' href='/favicon/favicon-16x16.png' />
<link rel='apple-touch-icon' sizes='180x180' href='/favicon/apple-touch-icon.png' />
<link rel='manifest' href='/favicon/site.webmanifest' />

{/* Font preloads */}
<Font cssVariable='--font-satoshi' preload={[{ subset: 'latin', style: 'normal' }]} />
<style>
  body {
    font-family: var(--font-satoshi);
  }
</style>

{/* Canonical URL */}
<link rel='canonical' href={canonicalURL} />

{/* Primary Meta Tags */}
<meta content={siteTitle} name='title' />
<meta content={description} name='description' />
<meta content={config.author} name='author' />

{/* Theme Color */}
{/* <meta content='' name='theme-color' /> */}
<meta name='color-scheme' content='light dark' />

{/* Open Graph / Facebook */}
<meta content={articleDate ? 'article' : 'website'} property='og:type' />
<meta content={title} property='og:title' />
<meta content={description} property='og:description' />
<meta content={canonicalURL} property='og:url' />
<meta content={config.title} property='og:site_name' />
<meta content={config.locale.attrs} property='og:locale' />
<meta content={socialImageURL} property='og:image' />
<meta content='1200' property='og:image:width' />
<meta content='630' property='og:image:height' />
{
  articleDate && (
    <>
      <meta content={config.author} property='article:author' />
      <meta content={articleDate} property='article:published_time' />
      <meta content={modifiedDate ?? articleDate} property='article:modified_time' />
      {tags?.map((tag) => <meta content={tag} property='article:tag' />)}
    </>
  )
}

{/* Structured data */}
<script is:inline type='application/ld+json' set:html={jsonLd} />

{/* Twitter */}
<meta content='summary_large_image' property='twitter:card' />
<meta content={canonicalURL} property='twitter:url' />
<meta content={title} property='twitter:title' />
<meta content={description} property='twitter:description' />
<meta content={socialImageURL} property='twitter:image' />

{/* Sitemap */}
<link href='/sitemap-index.xml' rel='sitemap' />

{/* RSS auto-discovery */}
<link
  rel='alternate'
  type='application/rss+xml'
  title={config.title}
  href={`${Astro.site}rss.xml`}
/>

<meta content={Astro.generator} name='generator' />

{
  /* User script*/
  prod && (
    <script>
      console.log( '%c Astro Theme Pure %c https://github.com/cworld1/astro-theme-pure/',
      'color:#fff;background:linear-gradient(90deg,#448bff,#44e9ff);padding:5px 0;',
      'color:#000;background:linear-gradient(90deg,#44e9ff,#ffffff);padding:5px 10px 5px 0px;' )
    </script>
  )
}

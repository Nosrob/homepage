---
import type { MarkdownHeading } from 'astro'

import { TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'

interface Props {
  title: string
  description?: string
  headings?: MarkdownHeading[]
}

const { title, description, headings, ...props } = Astro.props
---

<PageLayout meta={{ title, description }} {...props}>
  {headings?.length && <TOC headings={headings} slot='sidebar' />}

  <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl' slot='header'>{title}</h1>

  <slot />

  <slot name='bottom' slot='bottom' />

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>
